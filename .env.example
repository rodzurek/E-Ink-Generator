# Copy to .env and fill in. .env is git-ignored; this file is not.
# The server reads .env on start (npm start); restart it after editing.

# Required. Every generation is billed to this key.
OPENAI_API_KEY=sk-change-me

# Optional. The model the page starts on; the picklist itself is MODELS in server.js.
# OPENAI_IMAGE_MODEL=gpt-image-1

# Optional. low, medium or high; low is plenty at 240px.
# OPENAI_IMAGE_QUALITY=low

# Optional. Folder for every generated image and its prompt; relative paths
# start at the app folder.
# IMAGES_DIR=images

# Optional. Folder holding each display's current frame (inbox/<device>.json).
# INBOX_DIR=inbox

# Cloudflare Access (Zero Trust). With both set, every request except
# /api/health must carry a valid Access token from a user or device listed in
# config.json, and TOKEN, DEV_USER and DEV_DEVICE are ignored.
# ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
# ACCESS_AUD=the-access-application-audience-tag

# Optional. Users, partners and devices; copy config.example.json. Relative
# paths start at the app folder.
# CONFIG_FILE=config.json

# Local runs without Access: act as this user on the website, and as this
# device (its id in config.json) on /api/device/*.
# DEV_USER=partner-one@example.com
# DEV_DEVICE=one-display

# Optional, and only without Access. When set, every path except /api/health
# wants ?token= or an x-token header.
# TOKEN=change-me

# Optional.
# APP_NAME=e-ink-generator
# PORT=8090
# HOST=0.0.0.0   (127.0.0.1 when cloudflared runs on the same node)
